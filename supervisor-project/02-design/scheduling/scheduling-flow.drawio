                <mxCell id="t1" value="UQ_Run_ScheduledSlot violation:&#10;log, exit job cleanly&#10;(no JobExecutionException)&#10;existing Run = COMPLETED / IN_PROGRESS / ABANDONED / SKIPPED_FLAG_OFF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;" parent="1" vertex="1">
