    <diagram id="triggers" name="1 - Three trigger sources">
        <mxGraphModel dx="1076" dy="818" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="540" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="src1" value="Scheduled trigger&#10;Quartz CronTrigger fires&#10;clustered - one pod picks it up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="250" height="64" as="geometry" />
                </mxCell>
                <mxCell id="src2" value="On-demand&#10;JMS on CAMT.ONDEMAND.QUEUE&#10;carries a list of ConfigIds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="325" y="60" width="250" height="64" as="geometry" />
                </mxCell>
                <mxCell id="src3" value="PHT balance push&#10;JMS on CAMT.PHT.QUEUE&#10;fixed-width body, account balances" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="610" y="60" width="250" height="64" as="geometry" />
                </mxCell>
                <mxCell id="mid1" value="Scheduling job&#10;- take scheduled fire time (not wall-clock)&#10;- window function: scheduled_time + window&#10;  (rolling / boundary / calendar-day)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="180" width="250" height="84" as="geometry" />
