    <diagram id="windows" name="3 - The three window shapes">
        <mxGraphModel dx="1076" dy="818" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="600" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="la" value="Rolling&#10;EVERY_1_HOUR" style="text;html=1;align=left;verticalAlign=middle;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="70" width="150" height="50" as="geometry" />
                </mxCell>
                <mxCell id="ra0" value="..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontColor=#888888;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="76" width="50" height="40" as="geometry" />
                </mxCell>
                <mxCell id="ra1" value="11:00-12:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="240" y="76" width="120" height="40" as="geometry" />
                </mxCell>
                <mxCell id="ra2" value="12:00-13:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="76" width="120" height="40" as="geometry" />
                </mxCell>
                <mxCell id="ra3" value="13:00-14:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="480" y="76" width="120" height="40" as="geometry" />
                </mxCell>
                <mxCell id="ra4" value="..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontColor=#888888;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="600" y="76" width="50" height="40" as="geometry" />
                </mxCell>
                <mxCell id="capa" value="window = (fire - interval, fire] ;  a new window every interval, on the hour ;  first window 00:00 -&gt; 01:00" style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="190" y="124" width="460" height="30" as="geometry" />
                </mxCell>
                <mxCell id="lb" value="Boundary&#10;FOUR_TIMES_PER_DAY" style="text;html=1;align=left;verticalAlign=middle;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="220" width="150" height="50" as="geometry" />
                </mxCell>
                <mxCell id="rb0" value="00:00-10:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="226" width="200" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rb1" value="10:00-13:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="226" width="90" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rb2" value="13:00-18:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="480" y="226" width="120" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rb3" value="18:00-21:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="226" width="90" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rb4" value="21:00-24:00&#10;(not reported)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontColor=#888888;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="690" y="226" width="90" height="40" as="geometry" />
                </mxCell>
                <mxCell id="capb" value="fires AT each boundary ;  window = (previous boundary, this boundary] ;  implicit leading 00:00 covers the first window ;  boundary times are config" style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="190" y="274" width="540" height="40" as="geometry" />
                </mxCell>
                <mxCell id="lc" value="Calendar-day&#10;END_OF_DAY" style="text;html=1;align=left;verticalAlign=middle;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="380" width="150" height="50" as="geometry" />
                </mxCell>
                <mxCell id="rc0" value="previous calendar day    00:00 -&gt; 24:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="386" width="300" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rc1" value="fire 06:00 next day&#10;(Tue-Sat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#666666;fontColor=#333333;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="540" y="386" width="180" height="40" as="geometry" />
                </mxCell>
                <mxCell id="rce" value="produces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;fontColor=#333333;fontSize=10;" parent="1" source="rc0" target="rc1" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="capc" value="window = the WHOLE previous calendar day ;  23 h or 25 h on a DST transition day (intended)" style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="190" y="434" width="540" height="30" as="geometry" />
                </mxCell>
                <mxCell id="wnote" value="All times Europe/Stockholm. Business day Mon-Fri (Tue-Sat for END_OF_DAY). 21:00 -&gt; 24:00 is never reported same-day by rolling or boundary frequencies - only the calendar-day shape covers it, one day later." style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="30" y="510" width="740" height="40" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
