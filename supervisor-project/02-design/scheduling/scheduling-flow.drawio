                <mxCell id="mid2" value="On-demand listener&#10;- mint execution_id&#10;- window = requested period" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="325" y="180" width="250" height="84" as="geometry" />
                </mxCell>
                <mxCell id="mid3" value="PHT listener&#10;- resolve recipient: Agreement -&gt; AgreementVersion(ACTIVE) -&gt; AgreementScope&#10;- mint acceptance_id&#10;- merge pushed balances" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;" parent="1" vertex="1">
